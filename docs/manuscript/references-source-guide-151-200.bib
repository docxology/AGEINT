@misc{ageint172,
  title = {The Ethics of Cognitive Security - YorkSpace},
  key = {ageint172},
  url = {https://yorkspace.library.yorku.ca/server/api/core/bitstreams/f82a16e0-41eb-4387-9517-dcc5277027c1/content},
  note = {This 2023 York University doctoral dissertation by Andrew Ward Buzzell provides an ethical and epistemic assessment of state power exercised to defend against information threats, a domain the author terms cognitive security},
}

@misc{ageint173,
  title = {Epistemic Security - Elizabeth Seger},
  key = {ageint173},
  url = {https://elizabethseger.com/epistemic-security/},
  note = {A project page from AI governance and ethics researcher Elizabeth Seger introducing the concept of epistemic security: protecting the processes through which information is created, distributed, and consumed in society. It discusses information threats to democracies such as disinformation, eroding trust in institutions, polarization, and the misuse of generative AI, and how technologies shape knowledge production},
}

@misc{ageint174,
  title = {Epistemic Security 2029: Fortifying the UK's Information Supply},
  key = {ageint174},
  url = {http://demos.co.uk/wp-content/uploads/2025/02/Epistemic-Security-2029_accessible.pdf},
  note = {A February 2025 Demos report by Elizabeth Seger, Hannah Perry, and Jamie Hancock on strengthening the UK's information supply chain. It frames epistemic security, securing healthy and robust flows of trustworthy information, as essential to countering what it calls a democratic emergency driven by institutional distrust, the decline of local news, and concentrated control of information by social media platforms},
}

@misc{ageint175,
  title = {Tackling threats to informed decision- making in democratic societies},
  key = {ageint175},
  url = {https://www.turing.ac.uk/sites/default/files/2020-10/epistemic-security-report_final.pdf},
  note = {A 2020 Alan Turing Institute report, authored by Elizabeth Seger, Shahar Avin, and colleagues from Cambridge and the UK Defence Science and Technology Laboratory, on promoting epistemic security in technologically advanced democracies. It examines threats to informed decision-making and collective action, analyzing vulnerabilities in social epistemic infrastructures such as adversaries and blunderers, attention scarcity, group polarization, and the erosion of trust},
}

@misc{ageint176,
  title = {Understanding the Neurocognitive Mechanisms of Cognitive Security},
  key = {ageint176},
  url = {https://www.sciencedirect.com/science/article/abs/pii/S014976342500449X},
  note = {SIST guide bibliography entry},
}

@misc{ageint177,
  title = {Understanding the neurocognitive mechanisms of cognitive security},
  key = {ageint177},
  url = {https://pubmed.ncbi.nlm.nih.gov/41167441/},
  note = {A peer-reviewed review article published in Neuroscience \& Biobehavioral Reviews (December 2025) by Crum and colleagues examining the neurocognitive mechanisms of cognitive security. The authors synthesize research on why people fall victim to false or deceptive information, proposing that certain brain systems are more exploitable than others},
}

@misc{ageint178,
  title = {Neuro-cognitive approaches to cybersecurity: a systematic review},
  key = {ageint178},
  url = {https://www.emerald.com/ics/article/doi/10.1108/ICS-03-2024-0076/1332910/Neuro-cognitive-approaches-to-cybersecurity-a},
  note = {A January 2026 systematic review in Information and Computer Security by the researcher Kritika, titled "Neuro-cognitive approaches to cybersecurity." It integrates findings from neuroscience and cognitive psychology to analyze the human factor in security, examining how cognitive and neurological insights can improve security awareness education, behavioral policy development, insider threat detection, and user interface design},
}

@misc{ageint179,
  title = {Survey of Metrics for Cognitive Load in Intelligence Community},
  key = {ageint179},
  url = {https://ncsu-las.org/2024/11/survey-of-metrics-for-cognitive-load-in-intelligence-community-settings/},
  note = {An NCSU Laboratory for Analytic Sciences article summarizing a systematic survey of metrics for measuring cognitive load in intelligence-analysis and similar settings. Reviewing 125 articles published between 1998 and 2024, it identifies 129 distinct metrics grouped into non-biometric methods (questionnaires such as NASA-TLX, task performance, interaction tracking) and biometric methods (eye tracking, heart rate)},
}

@misc{ageint180,
  title = {Why Psychology of Intelligence Analysis Still Matters?},
  key = {ageint180},
  url = {https://www.specialeurasia.com/2024/08/19/psychology-intelligence-analysis/},
  note = {A SpecialEurasia article (2024) reviewing Richards J. Heuer Jr.'s 1999 work Psychology of Intelligence Analysis and arguing for its continued relevance. It summarizes Heuer's account of how cognitive biases such as confirmation bias, anchoring, and availability heuristics distort analytic judgment, and how analysts' backgrounds shape interpretation},
}

@misc{ageint181,
  title = {Effectiveness of training actions aimed at improving critical thinking},
  author = {Jose Manuel Marcos-Vilchez and Jose Antonio Muniz-Velazquez and Alazne Arraztio-Cordoba and Milagrosa Sanchez-Martin},
  year = {2026},
  url = {https://www.nature.com/articles/s41599-025-06143-6},
  note = {A systematic review in Humanities and Social Sciences Communications, published online 9 December 2025 and assigned to volume 13, article 53 (2026), not Nature Communications. The abstract reports 17 included studies, predominantly involving higher-education students and mainly moderate risks of bias, but only seven studies rigorously meeting its eligibility criteria},
}

@misc{ageint182,
  title = {Psychological Inoculation for Credibility Assessment, Sharing},
  author = {Chang Lu and Bo Hu and Qiang Li and Chao Bi and Xing-Da Ju},
  year = {2023},
  url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC10498317/},
  note = {A methodologically contested 2023 Journal of Medical Internet Research meta-analysis whose authors report 42 independent studies with 42,530 participants. The authors report improvements in credibility and sharing discernment but no statistically significant overall effect on misinformation-sharing intention; these measured outcomes do not establish observed sharing behavior or durable real-world protection},
}

@misc{ageint183,
  title = {Prebunking interventions based on "inoculation" theory can reduce},
  key = {ageint183},
  url = {https://misinforeview.hks.harvard.edu/article/global-vaccination-badnews/},
  note = {A 2020 peer-reviewed study in the Harvard Kennedy School Misinformation Review by Roozenbeek, van der Linden, and Nygren testing the Bad News game as a prebunking intervention grounded in inoculation theory. Players take the role of a misinformation creator to learn common manipulation techniques such as impersonation, emotional appeals, polarization, and conspiratorial framing, building resistance to deceptive content},
}

@misc{ageint184,
