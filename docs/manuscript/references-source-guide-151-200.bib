@misc{ageint154,
  title = {CrewAI},
  key = {ageint154},
  url = {https://crewai.com},
  note = {The homepage of CrewAI, a commercial platform for building, deploying, and managing AI agents at scale for enterprises. It presents the product as covering the full lifecycle from identifying automation opportunities to launching and optimizing multi-agent workflows while maintaining enterprise-level control},
}

@misc{ageint155,
  title = {Model Context Protocol (MCP): Security Design Considerations},
  key = {ageint155},
  url = {https://www.nsa.gov/Portals/75/documents/Cybersecurity/CSI_MCP_SECURITY.pdf?ver=bmgiSbNQLP6Z_GiWtRt6bg%3D%3D},
  note = {NSA cybersecurity information sheet on Model Context Protocol (MCP) security design considerations for AI-driven automation. It provides organizational design guidance for assessing MCP implementation risks and adoption safeguards; it is not evidence of experimental attack success rates, a vulnerability-scanner evaluation, or demonstrated control efficacy},
}

@misc{ageint156,
  title = {MCP Security 101: A New Protocol for Agentic AI - Protect AI},
  key = {ageint156},
  url = {https://protectai.com/blog/mcp-security-101},
  note = {A Protect AI blog post (April 2025) introducing the Model Context Protocol (MCP), the open-source layer Anthropic introduced in November 2024 to standardize how large language model applications connect to data sources and tools. The article explains how MCP acts as middleware between models and downstream services and surveys associated security risks, including overly broad permissions, unvetted servers, exposed endpoints, and limited monitoring},
}

@misc{ageint157,
  title = {Building Agentic AI with MCP - Bandwidth},
  key = {ageint157},
  url = {https://www.bandwidth.com/blog/agentic-ai-mcp/},
  note = {This is a Bandwidth blog post explaining how the Model Context Protocol (MCP) supports agentic AI systems that can assess context and take actions rather than only respond to prompts. Using a contact-center voice agent example, it describes MCP as a standard for letting AI models interact securely with external tools, APIs, and data sources, and covers instructions versus multi-step workflows},
}

@misc{ageint158,
  title = {AI Spotlight: MCP (Model Context Protocol) and Agentic AI systems},
  key = {ageint158},
  url = {https://www.gravitee.io/blog/mcp-model-context-protocol-agentic-ai},
  note = {A Gravitee blog post explaining the Model Context Protocol (MCP), an open standard developed by Anthropic for how applications provide context and tools to large language models. It compares MCP to a universal connector that replaces custom per-tool integrations, describing an architecture of hosts, clients, and servers and benefits such as reusability, provider flexibility, and improved access controls. The post situates MCP within the broader growth of agentic AI systems},
}

@misc{ageint159,
  title = {Security Risks of Agentic AI: A Model Context Protocol (MCP},
  key = {ageint159},
  url = {https://businessinsights.bitdefender.com/security-risks-agentic-ai-model-context-protocol-mcp-introduction},
  note = {A September 2025 Bitdefender Business Insights article by Martin Zugec examining security risks in the Model Context Protocol, the standard introduced by Anthropic for connecting AI agents to external tools and data. It identifies concerns including weak default authentication, supply-chain exposure from compromised tools, over-permissioned access tokens, injection and context-poisoning attacks, and gaps in audit logging for agentic workflows},
}

@misc{ageint160,
  title = {Breaking down the Top 12 Papers on Agentic AI Governance},
  key = {ageint160},
  url = {https://www.linkedin.com/posts/oliver-patel_breaking-down-the-top-12-papers-on-agentic-activity-7355531066830376960-ynF3},
  note = {Oliver Patel compiled a three-part series summarizing twelve influential research papers on governing autonomous AI systems, organized around themes of security and safety, infrastructure and principal-agent theory, and regulatory and capability assessment. The papers collectively argue that governance cannot be applied reactively after agents act but must instead be embedded at the architectural level, preventing unauthorized autonomous behavior before it occurs},
}

@misc{ageint161,
  title = {New Governance Frameworks Offer a Roadmap for Managing Risks},
  key = {ageint161},
  url = {https://www.dwt.com/blogs/artificial-intelligence-law-advisor/2026/01/roadmap-for-managing-risks-unique-to-agentic-ai},
  note = {A January 2026 article from the law firm Davis Wright Tremaine on governance frameworks for agentic AI. It argues that autonomous, adaptive AI systems pose distinct risks, such as unauthorized or erroneous actions, biased decisions, data breaches, and opaque audit trails, that require governance beyond existing AI frameworks},
}

@misc{ageint162,
  title = {Agentic AI report reveals need for reliable autonomous operations},
  key = {ageint162},
  url = {https://www.dynatrace.com/news/blog/agentic-ai-report-reliable-autonomous-operations/},
  note = {A Dynatrace blog post summarizing its Pulse of Agentic AI 2026 report, based on a survey of over 900 organizational leaders on enterprise adoption of agentic AI. It finds high adoption in IT operations alongside planned budget increases, while identifying barriers to scaling including security and compliance concerns, difficulty monitoring agents, and unclear autonomy boundaries},
}

@misc{ageint163,
  title = {Karl Friston's Groundbreaking Research Lays the Foundation},
  key = {ageint163},
  url = {https://deniseholt.us/verses-ais-groundbreaking-research-lays-the-foundation-for-shared-natural-super-intelligence/},
  note = {An article on deniseholt.us covering a 2024 paper by VERSES AI researchers, led by Mahault Albarracin and co-authored by Karl Friston, titled Shared Protentions in Multi-Agent Active Inference. It explains how intelligent agents can develop shared, mutually aligned expectations about future states that enable coordinated group behavior without explicit communication, drawing on Husserl's work on temporal consciousness},
}

@misc{ageint164,
  title = {VERSES to Present Research at Active Inference Workshop},
  key = {ageint164},
  url = {https://www.verses.ai/news/verses-to-present-research-at-the-5th-international-workshop-on-active-inference-iwai-2024},
  note = {A press release from VERSES AI (August 2024) announcing that the company would act as lead sponsor of and present research at the 5th International Workshop on Active Inference (IWAI 2024) in Oxford. It states that VERSES researchers had 12 accepted papers spanning foundational capabilities, multi-agent systems, applications, and ethics, and that the company's chief scientist Karl Friston would speak},
}

