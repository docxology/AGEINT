@misc{ageint198,
  title = {Metoda GTD = Getting Things Done - Lukas Barda},
  key = {ageint198},
  url = {https://lukasbarda.cz/english/metoda-gtd-getting-things-done/},
  note = {A Czech-language explainer of the Getting Things Done (GTD) productivity method created by David Allen. It describes the system's core steps of capturing thoughts, clarifying them into actionable items, organizing and prioritizing, regularly reviewing, and executing, including the principle of doing any task that takes under two minutes immediately. The page also surveys software tools for implementing GTD, such as Todoist, OmniFocus, Trello, Evernote, and Notion},
